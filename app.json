{
  "expo": {
    "name": "khala-mvp",
    "slug": "khala-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./public/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.khala.app"
    },
    "web": {
      "favicon": "./public/favicon.ico"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "khala-app"
  }
}
